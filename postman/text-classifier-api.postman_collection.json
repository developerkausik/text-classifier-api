                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/classify",
            "body": { "mode": "raw", "raw": "{\n  \"text\": [\"not\", \"a\", \"string\"]\n}" }
          }
        }
      ]
    },
    {
      "name": "Diagnostics",
      "description": "Quick checks when something is not working.",
      "item": [
        {
          "name": "API is running",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Lists the classify endpoint', () => pm.expect(pm.response.json().endpoints).to.include('POST /api/classify'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/"
          }
        },
        {
          "name": "Ollama is running and has the model (only for AI_DRIVER=ollama)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Ollama answers', () => pm.response.to.have.status(200));",
                  "pm.test('Model ' + pm.variables.get('ollamaModel') + ' is installed (else run: ollama pull <model>)', () => {",
                  "    const wanted = pm.variables.get('ollamaModel');",
                  "    const names = pm.response.json().models.map(m => m.name);",
                  "    pm.expect(names.some(n => n === wanted || n.startsWith(wanted + ':'))).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{ollamaBaseUrl}}/api/tags"
          }
        }
      ]
    }
  ]
}
